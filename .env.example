APP_ENV=dev

# PostgreSQL (required — SQLite is no longer supported)
POSTGRES_USER=qbr
POSTGRES_PASSWORD=qbr
POSTGRES_DB=qbr
# Use 5433 on host if another Postgres already owns 5432 (common on Windows)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://qbr:qbr@127.0.0.1:5433/qbr

# Repo root override (Docker sets QBR_ROOT=/app)
# QBR_ROOT=

BACKEND_PORT=8000
FRONTEND_PORT=5173
QBR_MAX_MANAGED_WORKERS=4
